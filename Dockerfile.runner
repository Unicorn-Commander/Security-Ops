# syntax=docker/dockerfile:1
# Security-Ops ISOLATED RUNNER sidecar — `python -m app.runner` (app/runner/loop.py).
#
# This is NOT the API image. It is the ONLY process in the stack that:
#   * holds the Docker socket (host root) — it drives Strix sandbox containers, and
#   * shells out to the `strix` CLI to execute gate-cleared runs claimed from the
#     `run_queue` table.
# The internet-facing API image (Dockerfile) deliberately does neither. Keeping the
# blast radius (Docker socket + exploit-running subprocess) off the public surface is
# the whole point of the sidecar split — see deploy/bigboy/docker-compose.bigboy.yml.
#
# Build context is the REPOSITORY ROOT (compose: secops-runner.build.context = ../..).
# Same python:3.12-slim base + requirements install + source layout as Dockerfile,
# minus uvicorn/alembic, plus the Docker CLI client and the Strix engine.

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# --- Docker CLI client -----------------------------------------------------
# We need ONLY the client (`docker`), to talk to the host daemon over the mounted
# /var/run/docker.sock (Strix launches sandbox containers via that socket). We do
# NOT want the engine/containerd/runc that Debian's `docker.io` metapackage drags
# in (~300MB, and a daemon we never run). Docker's official apt repo ships a
# standalone `docker-ce-cli` package = just the client. That is the simplest
# reliable, arch-agnostic path on slim, so we add the repo and install only that.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg \
         -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] \
https://download.docker.com/linux/debian $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
         > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce-cli \
    && apt-get purge -y --auto-remove curl gnupg \
    && rm -rf /var/lib/apt/lists/*

# --- dependency layer (cached until requirements.txt changes) --------------
COPY requirements.txt ./
RUN pip install -r requirements.txt

# --- Strix engine ----------------------------------------------------------
# Package name confirmed from the Security-Ops bake-off decision record
# (memory `project_security_ops_strix.md`: "embedding the real Strix engine …
# `pip install strix-agent`, LiteLLM-based"). It provides the `strix` CLI that
# app/engine/strix_runner.py invokes (STRIX_BIN="strix"). Pinned to 1.0.4 — the
# version confirmed on PATH in the built image (`strix --version` → 1.0.4), paired
# with the sandbox image ghcr.io/usestrix/strix-sandbox:1.0.0.
RUN pip install strix-agent==1.0.4

# --- Nuclei engine (ProjectDiscovery, MIT) ---------------------------------
# Engine #2 (app/engine/nuclei_runner.py): templated breadth scanning behind the
# same authorization gate as Strix. Install the standalone release binary for the
# build arch (resolve the latest tag via the GitHub API — no version pin to chase),
# then bake the community templates into the image so scans are deterministic and
# do NOT phone home at runtime (the runner uses `-disable-update-check`).
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl unzip \
    && NUCLEI_VER=$(curl -fsSL https://api.github.com/repos/projectdiscovery/nuclei/releases/latest \
         | grep -oP '"tag_name":\s*"v\K[^"]+') \
    && ARCH=$(dpkg --print-architecture) \
    && curl -fsSL -o /tmp/nuclei.zip \
         "https://github.com/projectdiscovery/nuclei/releases/download/v${NUCLEI_VER}/nuclei_${NUCLEI_VER}_linux_${ARCH}.zip" \
    && unzip -o /tmp/nuclei.zip -d /usr/local/bin nuclei \
    && chmod +x /usr/local/bin/nuclei \
    && rm -f /tmp/nuclei.zip \
    && nuclei -update-templates || true \
    && apt-get purge -y --auto-remove curl unzip \
    && rm -rf /var/lib/apt/lists/*

# --- Gitleaks engine (engine #3, secret scanning, MIT) ---------------------
# app/engine/gitleaks_runner.py scans gate-cleared REPO targets for hard-coded
# secrets (working tree + git history). Install the standalone release binary for
# the build arch (resolve the latest tag via the GitHub API — no version pin to
# chase). `git` is required at runtime: the runner clones URL targets before
# scanning (the clone happens in the spawned process so the E-stop can kill it).
# Gitleaks ships its rules embedded in the binary, so there is NOTHING to fetch at
# runtime (no phone-home).
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git \
    && GITLEAKS_VER=$(curl -fsSL https://api.github.com/repos/gitleaks/gitleaks/releases/latest \
         | grep -oP '"tag_name":\s*"v\K[^"]+') \
    && ARCH=$(dpkg --print-architecture) \
    && case "$ARCH" in amd64) GLARCH=x64 ;; arm64) GLARCH=arm64 ;; *) GLARCH="$ARCH" ;; esac \
    && curl -fsSL -o /tmp/gitleaks.tar.gz \
         "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VER}/gitleaks_${GITLEAKS_VER}_linux_${GLARCH}.tar.gz" \
    && tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks \
    && chmod +x /usr/local/bin/gitleaks \
    && rm -f /tmp/gitleaks.tar.gz \
    && apt-get purge -y --auto-remove curl \
    && rm -rf /var/lib/apt/lists/*

# --- Trivy engine (engine #4, CVE/SCA/IaC/secret, Apache-2.0) ---------------
# app/engine/trivy_runner.py scans IMAGE (`trivy image`) and REPO (`trivy fs`/
# `trivy repo`) targets for vulnerable packages, misconfigurations, and secrets.
# Install the standalone release binary for the build arch (resolve the latest tag
# via the GitHub API — no version pin to chase), then PRE-CACHE the vulnerability
# DB into the image (`--download-db-only`) so the first scan does not block on a DB
# pull. Trivy still refreshes the DB opportunistically at runtime (default cadence);
# it degrades gracefully to the baked DB when offline. NOTE: `trivy image` needs the
# Docker socket to pull/inspect images — the runner already mounts it for Strix.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && TRIVY_VER=$(curl -fsSL https://api.github.com/repos/aquasecurity/trivy/releases/latest \
         | grep -oP '"tag_name":\s*"v\K[^"]+') \
    && ARCH=$(dpkg --print-architecture) \
    && case "$ARCH" in amd64) TVARCH=64bit ;; arm64) TVARCH=ARM64 ;; *) TVARCH="$ARCH" ;; esac \
    && curl -fsSL -o /tmp/trivy.tar.gz \
         "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VER}/trivy_${TRIVY_VER}_Linux-${TVARCH}.tar.gz" \
    && tar -xzf /tmp/trivy.tar.gz -C /usr/local/bin trivy \
    && chmod +x /usr/local/bin/trivy \
    && rm -f /tmp/trivy.tar.gz \
    && trivy image --download-db-only || true \
    && apt-get purge -y --auto-remove curl \
    && rm -rf /var/lib/apt/lists/*

# --- Opengrep engine (SAST, Semgrep-compatible) ---------------------------
# app/engine/opengrep_runner.py scans REPO targets by cloning them into the run dir
# and invoking `opengrep scan --json`. Install the standalone Linux release binary
# for the build arch (latest tag via the GitHub API).
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git unzip \
    && OPENGREP_VER=$(curl -fsSL https://api.github.com/repos/opengrep/opengrep/releases/latest \
         | grep -oP '"tag_name":\s*"v\K[^"]+') \
    && ARCH=$(dpkg --print-architecture) \
    && case "$ARCH" in amd64) OGARCH=x86_64 ;; arm64) OGARCH=arm64 ;; *) OGARCH="$ARCH" ;; esac \
    && curl -fsSL -o /tmp/opengrep.zip \
         "https://github.com/opengrep/opengrep/releases/download/v${OPENGREP_VER}/opengrep_${OPENGREP_VER}_linux_${OGARCH}.zip" \
    && unzip -o /tmp/opengrep.zip -d /opt/opengrep \
    && ln -sf "$(find /opt/opengrep -name opengrep | head -n1)" /usr/local/bin/opengrep \
    && chmod +x /usr/local/bin/opengrep \
    && rm -f /tmp/opengrep.zip \
    && apt-get purge -y --auto-remove curl unzip \
    && rm -rf /var/lib/apt/lists/*

# --- OWASP ZAP engine (DAST) ----------------------------------------------
# app/engine/zap_runner.py runs the baseline scanner one target at a time. This is
# the heaviest layer: Java runtime + official ZAP cross-platform zip into /opt/zap.
# TODO: consider a separate zap sidecar image if this layer bloats too much.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl default-jre-headless unzip \
    && ZAP_VER=$(curl -fsSL https://api.github.com/repos/zaproxy/zaproxy/releases/latest \
         | grep -oP '"tag_name":\s*"v\K[^"]+') \
    && curl -fsSL -o /tmp/zap.zip \
         "https://github.com/zaproxy/zaproxy/releases/download/v${ZAP_VER}/ZAP_${ZAP_VER}_Crossplatform.zip" \
    && unzip -o /tmp/zap.zip -d /opt/zap \
    && ln -sf "$(find /opt/zap -name zap-baseline.py | head -n1)" /usr/local/bin/zap-baseline.py \
    && ln -sf "$(find /opt/zap -name zap.sh | head -n1)" /usr/local/bin/zap.sh \
    && chmod +x /usr/local/bin/zap-baseline.py /usr/local/bin/zap.sh \
    && rm -f /tmp/zap.zip \
    && apt-get purge -y --auto-remove curl unzip \
    && rm -rf /var/lib/apt/lists/*

# --- Naabu engine (port discovery) ----------------------------------------
# app/engine/naabu_runner.py scans DOMAIN/IP_RANGE targets for open ports. Install
# the standalone binary, plus libpcap-dev for raw socket/packet dependencies.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl libpcap-dev unzip \
    && NAABU_VER=$(curl -fsSL https://api.github.com/repos/projectdiscovery/naabu/releases/latest \
         | grep -oP '"tag_name":\s*"v\K[^"]+') \
    && ARCH=$(dpkg --print-architecture) \
    && case "$ARCH" in amd64) NAARCH=amd64 ;; arm64) NAARCH=arm64 ;; *) NAARCH="$ARCH" ;; esac \
    && curl -fsSL -o /tmp/naabu.zip \
         "https://github.com/projectdiscovery/naabu/releases/download/v${NAABU_VER}/naabu_${NAABU_VER}_linux_${NAARCH}.zip" \
    && unzip -o /tmp/naabu.zip -d /usr/local/bin naabu \
    && chmod +x /usr/local/bin/naabu \
    && rm -f /tmp/naabu.zip \
    && apt-get purge -y --auto-remove curl unzip \
    && rm -rf /var/lib/apt/lists/*

# --- engine #5: Prowler (CSPM cloud posture, Apache-2.0) --------------------
# app/engine/prowler_runner.py scans gate-cleared CLOUD_ACCOUNT targets. Prowler is
# a heavy Python package with its own strict boto3/pydantic pins, so it is installed
# in an ISOLATED venv (NOT the app's site-packages) and exposed on PATH via a symlink
# — this keeps its dependency closure from ever clashing with `python -m app.runner`.
# Runtime cloud credentials (re-assuming the CLOUD_ROLE-attested role) are injected by
# the deploy, exactly like Strix's sandbox image and the model-gateway key.
RUN python -m venv /opt/prowler \
    && /opt/prowler/bin/pip install --no-cache-dir "prowler>=5,<6" \
    && ln -sf /opt/prowler/bin/prowler /usr/local/bin/prowler \
    && /usr/local/bin/prowler --version || true

# --- application source + migrations (SAME layout as Dockerfile, for parity) ---
# NOTE: the runner NEVER runs `alembic upgrade head` — the API entrypoint owns
# migrations; two racing migrators is a bug. alembic.ini/migrations/scripts are
# copied only so this image stays interchangeable with the API source tree.
COPY alembic.ini ./
COPY migrations ./migrations
COPY scripts ./scripts
COPY app ./app

# No EXPOSE / no uvicorn: the runner has NO inbound network surface. It only polls
# the DB (run_queue) and drives the Docker socket. Healthcheck omitted deliberately
# (there is no port to probe and no `/health`); liveness is observed via the loop's
# structured logs and `restart: unless-stopped`.

CMD ["python", "-m", "app.runner"]
