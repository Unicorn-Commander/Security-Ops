# ===========================================================================
# Security-Ops — environment configuration.  Copy to `.env` and fill in secrets.
# ===========================================================================
# Backend settings are read ONLY through app/core/config.py (pydantic-settings,
# env_prefix "SECOPS_", cached `settings` singleton). Never read os.environ
# elsewhere. Every SECOPS_* key the app consumes is documented below.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# "production" | "development".  auth_bypass is honored ONLY when == development.
SECOPS_ENVIRONMENT=production

# --- Database --------------------------------------------------------------
# Async SQLAlchemy URL (asyncpg driver). Either SECOPS_DATABASE_URL or a bare
# DATABASE_URL is accepted (AliasChoices). For host/venv runs this targets the
# compose-published port 5436; inside compose, docker-compose.yml overrides it
# to point at the in-network host `secops-db:5432`.
SECOPS_DATABASE_URL=postgresql+asyncpg://secops:secops@localhost:5436/secops

# --- CORS ------------------------------------------------------------------
# JSON array of allowed SPA origins.
SECOPS_CORS_ORIGINS=["http://localhost:5173","http://localhost:8131"]

# --- Auth / dev bypass -----------------------------------------------------
# When true AND environment==development, skips Keycloak and injects a dev
# EntitledUser. MUST stay false in production.
SECOPS_AUTH_BYPASS=false

# --- Keycloak SSO (OPERATOR authz) — suite realm "uchub" -------------------
SECOPS_KEYCLOAK_ENABLED=true
# Token issuer. Must match your deployment's Keycloak (dogfood vs prod).
SECOPS_KEYCLOAK_ISSUER=https://auth.unicorncommander.ai/realms/uchub
SECOPS_KEYCLOAK_REALM=uchub
SECOPS_KEYCLOAK_CLIENT_ID=security-ops
# Optional expected audience claim. Leave commented to keep it None (aud check skipped).
# SECOPS_KEYCLOAK_AUDIENCE=security-ops
# JWKS cache TTL, seconds.
SECOPS_KEYCLOAK_JWKS_TTL=3600

# --- Entitlement SKU (OPERATOR authz) --------------------------------------
# Realm role "app-security-ops" grants access; ADMIN bypasses. == settings.entitlement_sku.
SECOPS_ENTITLEMENT_SKU=security-ops

# --- Model routing (Phase 2 Strix runner) — INTERNAL-DIRECT, NOT Cloudflare -
# Long autonomous runs (30+ min, heavy streaming) 504/drop through the
# CF-fronted public gateway. Point the engine at the internal litellm over
# Tailscale/LAN (unicorn-litellm on bigboy); metering is preserved. (spec §7)
SECOPS_INTERNAL_LITELLM_BASE_URL=http://100.126.207.157:4000/v1
# Litellm API key. Leave commented to keep it None until Phase 2.
# SECOPS_INTERNAL_LITELLM_API_KEY=sk-...

# --- Strix engine (Phase 2) ------------------------------------------------
SECOPS_STRIX_SANDBOX_IMAGE=ghcr.io/usestrix/strix-sandbox:1.0.0
# Per-run reports land here: <runs_dir>/<run>/ (penetration_test_report.md, ...).
SECOPS_RUNS_DIR=./strix_runs

# --- Global kill-switch ----------------------------------------------------
# When true, the authorization gate DENIES every scan suite-wide (emergency stop).
SECOPS_EMERGENCY_STOP_ALL=false

# ===========================================================================
# docker-compose-only variables (consumed by docker-compose.yml, NOT the app).
# ===========================================================================
# Credentials for the secops-db service. docker-compose.yml builds the API's
# in-network SECOPS_DATABASE_URL from these three values.
POSTGRES_USER=secops
POSTGRES_PASSWORD=secops
POSTGRES_DB=secops
